# Secrets GitHub à configurer (Settings → Secrets and variables → Actions)
# pour signature et notarisation. Sans ces secrets, la CI produit des builds non signés.

# Mac (Developer ID Application, export .p12 en base64)
# MAC_CERTIFICATE_BASE64=
# MAC_CERTIFICATE_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Windows (certificat Authenticode .pfx en base64)
# WIN_CERTIFICATE_BASE64=
# WIN_CERTIFICATE_PASSWORD=
